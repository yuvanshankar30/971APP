API_KEY="replace-with-value-matching-spartans-hub-FUSION_RUNNER_TOKEN"
BASE_URL="http://localhost:3000"
RUNNER_ID="replace-with-a-name-for-this-machine"
# Only needed once more than one physical machine runs this add-in at the
# same time - find the right value with `select id, name from cam_machines;`
# in the Supabase SQL editor. Leave blank for a single-machine setup.
RUNNER_MACHINE_ID=""

# Which Fusion Data Panel project AutoCAM-generated documents get saved
# into (e.g. "2026 Season CAM"). Leave blank to fall back to whichever
# project is currently active in your Data Panel - fine for a single
# season, but explicit is safer if your account has several projects and
# jobs might run while a different one happens to be open.
FUSION_DATA_PROJECT_NAME=""

# Name of the folder (within the project above) that AutoCAM-generated
# documents get saved into - created automatically if it doesn't exist.
FUSION_DROP_FOLDER_NAME="AutoCAM Drop"
