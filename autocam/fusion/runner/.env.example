# REQUIRED. A unique per-install token written automatically after browser
# pairing. The team FUSION_RUNNER_TOKEN is entered only on the Spartans Hub
# pairing page and is never copied into this file.
API_KEY=""

# REQUIRED, but already set to a sensible default - only change this if
# the Hub itself is running locally on your machine instead of the real
# deployed one. Physical Fusion machines normally poll the deployed Hub,
# so leave this as-is unless you know you need something else.
BASE_URL="https://spartanshub.spartanrobotics.org"

# REQUIRED. The workstation hostname is written here automatically and shows
# up in the Hub's job queue so a team member can tell which Runner claimed it.
RUNNER_ID="replace-with-a-name-for-this-machine"

# REQUIRED. UUID of this physical machine's cam_machines row, registered or
# reused automatically during browser pairing.
RUNNER_MACHINE_ID="00000000-0000-4000-8000-000000000000"

# OPTIONAL. Which Fusion Data Panel project AutoCAM-generated documents get
# saved into. Leave commented/unset to use the default below (the team's
# real project) - only override this for a different Fusion account or a
# new season's project.
# FUSION_DATA_PROJECT_NAME="2026 Season CAM"

# OPTIONAL. Nested Data Panel folder path (within the project above,
# "/"-separated) that AutoCAM-generated documents get saved into. Leave this
# empty to save directly at the project's own root folder (the default). Set
# it only to nest generated documents under a subfolder instead.
FUSION_DROP_FOLDER_PATH=""
