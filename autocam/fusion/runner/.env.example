API_KEY="replace-with-value-matching-spartans-hub-FUSION_RUNNER_TOKEN"
# Use a local URL only when the Hub itself is running locally. Physical
# Fusion machines normally poll the deployed Hub.
BASE_URL="https://spartanshub.spartanrobotics.org"
RUNNER_ID="replace-with-a-name-for-this-machine"
# Only needed once more than one physical machine runs this add-in at the
# same time - find the right value with `select id, name from cam_machines;`
# in the Supabase SQL editor. Leave blank for a single-machine setup.
RUNNER_MACHINE_ID=""

# Which Fusion Data Panel project AutoCAM-generated documents get saved
# into. Leave commented/unset to use the default below (the team's real
# project) - only override this for a different Fusion account or a new
# season's project.
# FUSION_DATA_PROJECT_NAME="2026 Season CAM"

# Nested Data Panel folder path (within the project above, "/"-separated)
# that AutoCAM-generated documents get saved into - each segment created
# automatically if it doesn't already exist. Leave commented/unset to use
# the default below (the team's real, already-existing folder).
# FUSION_DROP_FOLDER_PATH="Offseason Projects/AutoCAM"
