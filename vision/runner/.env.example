# Copy to .env (or export these directly) on whatever host runs
# vision_runner.py. See ../README.md for the full setup and
# ../../docs/plans/scoutingvision-remaining-work.md for what's still missing before
# this is actually deployable.

# The web app's own origin - same value as PUBLIC_APP_ORIGIN in the main
# app's config (see ../../cloudbuild.yaml). No trailing slash.
VISION_API_URL=https://spartanshub.spartanrobotics.org

# Shared secret with the web app's VISION_RUNNER_TOKEN. Get the deployed
# value from the project administrator; do not generate a second value or
# commit a real token in this file.
VISION_RUNNER_TOKEN=replace-with-deployed-vision-runner-token

# Identifies this runner in the vision_runners fleet table/dashboard.
# Make it descriptive if running more than one (e.g. per-GPU-host).
VISION_RUNNER_ID=vision-runner-1

# Local path to trained weights. No model is committed to this repo - see
# docs/plans/scoutingvision-remaining-work.md for what's needed to get a real one.
# vision/training/create_placeholder_model.py can generate a NON-FUNCTIONAL
# placeholder (right class names, random weights) for exercising the
# claim/heartbeat/complete plumbing before a real model exists.
VISION_MODEL_PATH=/models/frc-vision-v1.pt

# Full, unquantized BF16 inference runs in the companion qwen service.
# In Docker Compose this hostname is internal and must not be exposed publicly.
VISION_QWEN_URL=http://qwen:8000
VISION_QWEN_MODEL=Qwen/Qwen3.8-27B
VISION_QWEN_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
VISION_QWEN_ATTENTION=sdpa
VISION_QWEN_DEVICE_MAP=cuda
VISION_QWEN_REQUIRED=true
VISION_QWEN_CLIP_SECONDS=5
VISION_QWEN_FRAMES_PER_CLIP=8
VISION_QWEN_JPEG_WIDTH=1280
VISION_QWEN_MAX_IMAGES=8
VISION_QWEN_MAX_IMAGE_PIXELS=921600
VISION_QWEN_MAX_JPEG_BYTES=2097152
VISION_QWEN_MAX_NEW_TOKENS=900

# Separate internal-service credential; do not reuse VISION_RUNNER_TOKEN.
# Generate with `openssl rand -hex 32` and give the same value to both
# services (docker compose does this through the shared .env file).
VISION_QWEN_TOKEN=replace-with-another-generated-secret

# Override only when the DGX OS-supported NGC PyTorch tag changes.
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.08-py3

# Optional - how often (seconds) to poll for queued runs when idle.
VISION_POLL_SECONDS=10

# --- AprilTag-assisted calibration (optional) --------------------------------
# These are per-run config values (vision_runs.config), not environment
# variables - listed here because this is where the runner's knobs are
# documented. Automatic calibration is opt-in twice over: it needs
# apriltag_autocalibrate true AND a layout path, and it never overrides a
# homography a human already drew.
#
#   apriltag_autocalibrate       true to enable at all (default false)
#   apriltag_layout_path         WPILib AprilTagFieldLayout JSON for the season
#   camera_horizontal_fov_deg    lens horizontal FOV; required, never guessed
#   apriltag_family              36h11 (default), 36h10, 25h9 or 16h5
#   apriltag_size_m              printed black-square size (default 0.1651)
#   apriltag_max_reprojection_px accepted error before the solve is refused
#                                (default 6.0)
#
# See vision/runner/README.md for what each gate rejects and why.
