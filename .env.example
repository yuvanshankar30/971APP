# OnShape API Configuration. Every OnShape-dependent feature (subsystem
# timelines, BOM loading, create-build) is already wired against these two
# vars via src/routes/api/onshape/+server.js - dropping in a valid key pair
# here is the only step needed to make them work again, no code change.
# If OnShape starts returning 401 "Unauthenticated API request" (check with
# a direct request to <base url>/api/v11/documents), the key has been
# revoked/rotated and a new pair must be generated together in OnShape
# (Account -> API Keys) - see cloudbuild.yaml for the production rotation
# steps (GitHub issue #86).
PUBLIC_ONSHAPE_ACCESS_KEY=your_onshape_access_key
PUBLIC_ONSHAPE_SECRET_KEY=your_onshape_secret_key
PUBLIC_ONSHAPE_BASE_URL=https://cad.onshape.com

# Supabase Configuration
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Error monitoring (optional) — Sentry is disabled when unset
PUBLIC_SENTRY_DSN=

# Optional scouting autonomous-path image export. Share this Drive folder with
# the service-account email contained in GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY.
SCOUTING_AUTO_PATHS_DRIVE_FOLDER_ID=
