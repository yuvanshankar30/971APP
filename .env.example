# OnShape API Configuration (if using environment variables)
PUBLIC_ONSHAPE_ACCESS_KEY=your_onshape_access_key
PUBLIC_ONSHAPE_SECRET_KEY=your_onshape_secret_key
PUBLIC_ONSHAPE_BASE_URL=https://cad.onshape.com

# Supabase Configuration
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Error monitoring (optional) — Sentry is disabled when unset
PUBLIC_SENTRY_DSN=

# Optional scouting autonomous-path image export. Share this Drive folder with
# the service-account email contained in GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY.
SCOUTING_AUTO_PATHS_DRIVE_FOLDER_ID=
